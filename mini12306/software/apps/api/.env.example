# 数据库（SQLite 单文件，位于 apps/api/prisma/dev.db）
DATABASE_URL="file:./dev.db"

# 服务端口
PORT=4000

# JWT 密钥（本地演示用，请勿用于生产）
JWT_SECRET="mini-12306-local-dev-secret"
JWT_EXPIRES_IN="12h"

# 证件号加密密钥（必须是 32 字节 = 64 位十六进制）
ID_CARD_AES_KEY="6d696e6931323330362d6c6f63616c2d6465762d6b65792d3230323630313031"

# 第三方服务模式：mock | real（本项目仅实现 mock）
PROVIDER_MODE="mock"

# Mock 短信验证码固定值（便于演示）
MOCK_SMS_CODE="123456"
